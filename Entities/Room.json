{
  "name": "Room",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Room name (e.g., Living Room, Kitchen)"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "bedroom",
        "bathroom",
        "kitchen",
        "living_room",
        "dining_room",
        "office",
        "garage",
        "storage",
        "laundry",
        "other"
      ]
    },
    "floor": {
      "type": "number",
      "description": "Floor number"
    },
    "coordinates": {
      "type": "object",
      "description": "SVG coordinates for floor plan rendering",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "occupied",
        "maintenance",
        "cleaning"
      ],
      "default": "idle"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of assigned worker"
    },
    "color": {
      "type": "string",
      "description": "Room color for visualization"
    }
  },
  "required": [
    "name",
    "room_type"
  ]
}